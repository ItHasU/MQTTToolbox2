# Template for docker-compose.prod.yml — copy to .env.prod (gitignored,
# never commit the real one: it ends up holding SECRET_KEY) and fill in.
#
#   cp .env.prod.example .env.prod
#
# Only these four are ever read from the environment (Dagda FEATURES
# §11.5) — everything else (broker URL/credentials, history retention, ...)
# is a system setting, stored in the database and edited from the
# Paramètres screen after first login, not a variable here.

# -- Image --
# Matches a tag pushed by .github/workflows/docker.yml (one per branch,
# slashes sanitized to dashes) — spec-reboot is the active branch as of
# this writing; switch to whatever branch you actually want once merged.
MQTT_IMAGE_TAG=spec-reboot

# -- HTTP server --
# The port docker-compose.prod.yml publishes on the host.
MQTT_PORT=3000
# The address this instance is actually reachable at — used to build
# absolute links (e.g. the invite links the Utilisateurs screen generates).
# Not http://localhost:3000 unless you really are only ever accessing it
# from the machine that runs it.
MQTT_BASE_URL=http://your-server:3000

# -- Database --
# The same three values seed both the `postgres` service (as
# POSTGRES_USER/PASSWORD/DB) and the app's own DB_URL — change the
# password before a real deployment, the default matches local dev on
# purpose so a fresh `docker compose up` just works.
MQTT_DB_USER=mqtt
MQTT_DB_PASSWORD=mqtt
MQTT_DB_NAME=mqtt

# -- Secrets --
# Protects secret system settings (the broker password, notably) at rest.
# The server refuses to start without one. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Deliberately left blank here — same reasoning as .env.example: a key
# shipped in a template is a key that ends up in production.
MQTT_SECRET_KEY=

# -- Optional bundled broker --
# Only read if you keep the `mosquitto` service in docker-compose.prod.yml
# (see its own comment there for why you might remove it instead).
MQTT_BROKER_PORT=1883
