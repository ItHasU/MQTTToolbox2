# Bootstrap configuration, read from the environment.
# Anything that can live in the database is a system parameter, not a variable
# here (Dagda FEATURES §11.5).

# -- HTTP server --
PORT=3000
BASE_URL=http://localhost:3000

# -- Database --
DB_URL=postgresql://mqtt:mqtt@localhost:5433/mqtt

# -- MQTT broker --
# Temporary: the broker configuration belongs to the system parameters, whose
# editing screen needs the roles of a later slice. Until then, bootstrapped here.
MQTT_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=mqtt-toolbox
MQTT_TOPICS=#
#MQTT_USERNAME=
#MQTT_PASSWORD=
