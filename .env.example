# Bootstrap configuration, read from the environment.
# Anything that can live in the database is a system parameter, not a variable
# here (Dagda FEATURES §11.5).

# -- HTTP server --
PORT=3000
BASE_URL=http://localhost:3000

# -- Database --
DB_URL=postgresql://mqtt:mqtt@localhost:5433/mqtt

# -- Secrets --
# Protects the secret system parameters at rest. Bootstrap for the same reason
# as DB_URL: it cannot be read from the table it protects.
#
# Deliberately empty: a key shipped in an example file is a key that ends up in
# production. The server refuses to start without it and repeats this command.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SECRET_KEY=

# -- MQTT broker --
# These seed the system parameters on the FIRST run only. Once a value is
# stored, editing here changes nothing — the server says so at startup. The
# editing screen arrives with the roles (ROADMAP tranche 3).
MQTT_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=mqtt-toolbox
# Quoted: in a .env file an unquoted # opens a comment, so MQTT_TOPICS=# reads
# as empty. The default happens to be the same, which is exactly what makes it
# hard to notice.
MQTT_TOPICS="#"
MQTT_ENABLED=true
#MQTT_USERNAME=
#MQTT_PASSWORD=

# -- History --
# Messages kept per topic; 0 keeps everything.
HISTORY_MESSAGES_PER_TOPIC=1000
